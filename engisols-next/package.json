{
  "name": "engisols-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:scanner:build": "rm -rf .scanner-test-dist && tsc -p tsconfig.scanner-tests.json",
    "test:scanner": "npm run test:scanner:build && node --test .scanner-test-dist/tests/scanner/*.test.js",
    "test:production-check": "npm run test:scanner:build && node --test .scanner-test-dist/tests/production-check/*.test.js",
    "test:scanner:regression": "npm run test:scanner:build && node scripts/scanner-regression.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "motion": "^13.1.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
