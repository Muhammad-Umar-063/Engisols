# PostHog configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Growth Copilot sanitized outcome delivery (server only; use distinct preview
# and production values, never expose these with NEXT_PUBLIC_ prefixes).
GROWTH_ANALYTICS_ID_KEY=replace_with_32_plus_random_bytes
GROWTH_REDIS_DURABILITY_VERIFIED=false
GROWTH_COPILOT_WEBHOOK_URL=https://growth-copilot.example/api/webhooks/engisols/outcomes
GROWTH_COPILOT_WEBHOOK_SECRET=replace_with_32_plus_random_bytes
GROWTH_COPILOT_EXPORT_TOKEN=replace_with_32_plus_random_bytes
GROWTH_COPILOT_EXPORT_TOKEN_PREVIOUS=
GROWTH_COPILOT_EXPORT_CURSOR_SECRET=replace_with_different_32_plus_random_bytes
GROWTH_COPILOT_EXPORT_CURSOR_SECRET_PREVIOUS=
GROWTH_COPILOT_OUTBOX_CRON_SECRET=replace_with_32_plus_random_bytes
GROWTH_COPILOT_OUTBOX_CRON_SECRET_PREVIOUS=
