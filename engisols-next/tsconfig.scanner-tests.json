{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "outDir": ".scanner-test-dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "app/api/scan/route.ts",
    "app/api/scans/route.ts",
    "app/api/production-check/**/*.ts",
    "app/api/ai-app-audit/**/*.ts",
    "scripts/scanner-regression-policy.ts",
    "src/campaign/**/*.ts",
    "src/email/**/*.ts",
    "src/production-check/**/*.ts",
    "src/scanner/**/*.ts",
    "tests/scanner/**/*.ts",
    "tests/production-check/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".scanner-test-dist"]
}
